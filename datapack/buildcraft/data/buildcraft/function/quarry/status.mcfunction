scoreboard players set #status_markers bc_marker_count 0
execute as @e[type=minecraft:marker,tag=buildcraft.marker,distance=..256] run scoreboard players add #status_markers bc_marker_count 1
tellraw @s [{"text":"[BuildCraft Quarry]","color":"gold","bold":true}]
tellraw @s [{"text":"Markers detected: ","color":"gray"},{"score":{"name":"#status_markers","objective":"bc_marker_count"},"color":"aqua"},{"text":" / 2","color":"dark_gray"}]
execute if score @e[type=minecraft:marker,tag=buildcraft.quarry,distance=..3,sort=nearest,limit=1] bc_configured matches 0 if score #status_markers bc_marker_count matches 0 run tellraw @s [{"text":"WAITING: ","color":"yellow","bold":true},{"text":"Place the first marker on a blue line.","color":"yellow"}]
execute if score @e[type=minecraft:marker,tag=buildcraft.quarry,distance=..3,sort=nearest,limit=1] bc_configured matches 0 if score #status_markers bc_marker_count matches 1 run tellraw @s [{"text":"WAITING: ","color":"yellow","bold":true},{"text":"Place the second marker on another blue line from the Quarry.","color":"yellow"}]
execute if score @e[type=minecraft:marker,tag=buildcraft.quarry,distance=..3,sort=nearest,limit=1] bc_configured matches 0 if score #status_markers bc_marker_count matches 2 run tellraw @s [{"text":"CHECKING: ","color":"aqua","bold":true},{"text":"Validating the two-marker rectangle.","color":"aqua"}]
execute if score #status_markers bc_marker_count matches 3.. run tellraw @s [{"text":"BLOCKED: ","color":"red","bold":true},{"text":"Too many markers are nearby. Exactly two are required.","color":"red"}]
execute if score @e[type=minecraft:marker,tag=buildcraft.quarry,distance=..3,sort=nearest,limit=1] bc_configured matches -1 run tellraw @s [{"text":"INVALID: ","color":"red","bold":true},{"text":"The Quarry and markers must make a rectangle at least 2x2 and no larger than 64x64. Break one marker and try again.","color":"red"}]
execute if score @e[type=minecraft:marker,tag=buildcraft.quarry,distance=..3,sort=nearest,limit=1] bc_configured matches 1 run function buildcraft:quarry/status_running
